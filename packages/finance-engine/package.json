{
  "name": "@flump/finance-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./accounts": {
      "types": "./dist/accounts-entry.d.ts",
      "import": "./dist/accounts-entry.js",
      "default": "./src/accounts-entry.ts"
    },
    "./account-form": {
      "types": "./dist/account-form-entry.d.ts",
      "import": "./dist/account-form-entry.js",
      "default": "./src/account-form-entry.ts"
    },
    "./check-in": {
      "types": "./dist/check-in-entry.d.ts",
      "import": "./dist/check-in-entry.js",
      "default": "./src/check-in-entry.ts"
    },
    "./net-worth": {
      "types": "./dist/net-worth-entry.d.ts",
      "import": "./dist/net-worth-entry.js",
      "default": "./src/net-worth-entry.ts"
    },
    "./home-strip": {
      "types": "./dist/home-strip-entry.d.ts",
      "import": "./dist/home-strip-entry.js",
      "default": "./src/home-strip-entry.ts"
    },
    "./testing": {
      "types": "./dist/picture/__fixtures__/index.d.ts",
      "import": "./dist/picture/__fixtures__/index.js",
      "default": "./src/picture/__fixtures__/index.ts"
    },
    "./engine-check": {
      "types": "./dist/test-vectors/engine-check.d.ts",
      "import": "./dist/test-vectors/engine-check.js",
      "default": "./src/test-vectors/engine-check.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
