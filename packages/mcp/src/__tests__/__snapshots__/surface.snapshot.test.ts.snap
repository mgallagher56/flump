  {
    "_meta": undefined,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Projects net worth year by year from the recorded account balances, with and without up to 10 events that each carry an explicit one-off and/or monthly cost. The expected investment return is required. Monthly saving defaults to the budget surplus when a budget exists and is otherwise reported in missing[] and set to zero. Cash (4%), pension (6.5%) and property (2.5%) growth use those rates unless supplied; each is listed in assumptions. Mortgage repayments are not modelled, so equity grows only with property growth. Concise format returns every fifth year; detailed adds the balance breakdown.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "cashInterestPct": {
          "description": "Annual interest on cash, as a percentage. Defaults to 4.",
          "maximum": 30,
          "minimum": 0,
          "type": "number",
        },
        "events": {
          "default": [],
          "items": {
            "properties": {
              "becomesPropertyEquity": {
                "default": false,
                "description": "True when the one-off cost buys property (it then counts as equity, not spend)",
                "type": "boolean",
              },
              "durationYears": {
                "default": 1,
                "description": "Years the monthly cost lasts",
                "maximum": 40,
                "minimum": 1,
                "type": "integer",
              },
              "label": {
                "description": "Short name, for example Car",
                "maxLength": 40,
                "minLength": 1,
                "type": "string",
              },
              "lumpSumCostGbp": {
                "default": 0,
                "description": "One-off cost at the start, in GBP",
                "maximum": 10000000,
                "minimum": 0,
                "type": "number",
              },
              "monthlyCostGbp": {
                "default": 0,
                "description": "Extra cost each month while it lasts, in GBP",
                "maximum": 100000,
                "minimum": 0,
                "type": "number",
              },
              "startYear": {
                "description": "Years from now when it starts",
                "maximum": 40,
                "minimum": 1,
                "type": "integer",
              },
            },
            "required": [
              "label",
              "startYear",
            ],
            "type": "object",
          },
          "maxItems": 10,
          "type": "array",
        },
        "expectedReturnPct": {
          "description": "Assumed constant annual return on investments, as a percentage (5 means 5%). No default.",
          "maximum": 30,
          "minimum": 0,
          "type": "number",
        },
        "horizonYears": {
          "default": 10,
          "maximum": 40,
          "minimum": 1,
          "type": "integer",
        },
        "monthlySavingGbp": {
          "description": "Amount saved each month, in GBP. Defaults to the budget surplus.",
          "maximum": 100000,
          "minimum": 0,
          "type": "number",
        },
        "pensionReturnPct": {
          "description": "Annual pension growth, as a percentage. Defaults to 6.5.",
          "maximum": 30,
          "minimum": 0,
          "type": "number",
        },
        "propertyGrowthPct": {
          "description": "Annual property growth, as a percentage. Defaults to 2.5.",
          "maximum": 30,
          "minimum": 0,
          "type": "number",
        },
        "responseFormat": {
          "default": "concise",
          "description": "concise (default) keeps the answer short; detailed returns the full breakdown",
          "enum": [
            "concise",
            "detailed",
          ],
          "type": "string",
        },
      },
      "required": [
        "expectedReturnPct",
      ],
      "type": "object",
    },
    "name": "project_net_worth",
