  {
    "_meta": undefined,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Simulates paying off the user's recorded consumer debts (up to 20) with an optional extra monthly amount, under the avalanche (highest APR first) and snowball (smallest balance first) orderings, against minimum payments only. Debts with no recorded APR are left out and listed in missing[] unless an APR is supplied in debts[]; an APR is never guessed. Minimum payments that are not recorded are estimated and flagged. includeSchedule adds a yearly or monthly (at most 24 months) table for the first strategy. Student loans and mortgages are not included.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "debts": {
          "description": "APR or minimum payment to use for specific debts, when not recorded",
          "items": {
            "properties": {
              "accountId": {
                "description": "Debt id from get_debt_overview",
                "maxLength": 40,
                "type": "string",
              },
              "aprPct": {
                "description": "APR as a percentage (22.9 means 22.9%)",
                "maximum": 100,
                "minimum": 0,
                "type": "number",
              },
              "minimumPaymentGbp": {
                "description": "Monthly minimum payment in GBP",
                "maximum": 100000,
                "minimum": 0,
                "type": "number",
              },
            },
            "required": [
              "accountId",
            ],
            "type": "object",
          },
          "maxItems": 20,
          "type": "array",
        },
        "extraMonthlyGbp": {
          "description": "Extra amount paid each month on top of the minimums, in GBP. Omit for none.",
          "maximum": 100000,
          "minimum": 0,
          "type": "number",
        },
        "includeSchedule": {
          "default": "none",
          "description": "Payment schedule detail; monthly stops after 24 months",
          "enum": [
            "none",
            "yearly",
            "monthly",
          ],
          "type": "string",
        },
        "responseFormat": {
          "default": "concise",
          "description": "concise (default) keeps the answer short; detailed returns the full breakdown",
          "enum": [
            "concise",
            "detailed",
          ],
          "type": "string",
        },
        "strategy": {
          "default": "compare",
          "description": "Ordering to simulate; compare returns avalanche, snowball and minimum-only",
          "enum": [
            "avalanche",
            "snowball",
            "compare",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
