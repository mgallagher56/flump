  {
    "_meta": undefined,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Month-end balances recorded in Flump between two months, per account, per category or as a net-worth total, at monthly, calendar-quarter or calendar-year intervals (a period cut short by the range is flagged partial). metric balance gives the value at the end of each period; delta gives the change from the end of the previous period (current minus previous, up or down); pctDelta gives that change as a percentage. Liabilities are the amount owed as a positive number. A month with no recorded value carries the last known value forward and is flagged carriedForward; source says how each value was recorded. Student loans are excluded. Results are paged: ask for the next page while page is below totalPages.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "accountIds": {
          "description": "Only these accounts (short ids from list_accounts)",
          "items": {
            "maxLength": 40,
            "type": "string",
          },
          "maxItems": 50,
          "type": "array",
        },
        "category": {
          "description": "Only accounts in this category",
          "enum": [
            "cash",
            "savings",
            "investments",
            "pensions",
            "debt",
            "mortgages",
            "property",
            "studentLoans",
            "other",
          ],
          "type": "string",
        },
        "from": {
