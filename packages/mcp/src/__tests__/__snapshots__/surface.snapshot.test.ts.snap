    "description": "Sets the interest saved by overpaying a recorded mortgage by a fixed monthly amount beside the growth on the same amount invested at an expected annual return. Reads the mortgage balance, interest rate and remaining term from the mortgage account; anything not recorded is listed in missing[] and the comparison is left null rather than guessed. The expected return is required and is a single constant rate. The result states both outcomes and their difference; it does not choose between them.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "expectedReturnPct": {
          "description": "Assumed constant annual return on the invested amount, as a percentage (5 means 5%). Supplied by the user or agent; there is no default.",
          "maximum": 30,
          "minimum": 0,
          "type": "number",
        },
        "monthlyAmountGbp": {
          "description": "Monthly amount in GBP to compare (up to 100,000)",
          "maximum": 100000,
          "minimum": 0,
          "type": "number",
        },
        "mortgageAccountId": {
          "description": "Mortgage account id from list_accounts. Needed only when there is more than one.",
          "maxLength": 40,
          "type": "string",
        },
        "responseFormat": {
          "default": "concise",
          "description": "concise (default) keeps the answer short; detailed returns the full breakdown",
          "enum": [
            "concise",
            "detailed",
          ],
          "type": "string",
        },
      },
      "required": [
        "monthlyAmountGbp",
        "expectedReturnPct",
      ],
      "type": "object",
    },
