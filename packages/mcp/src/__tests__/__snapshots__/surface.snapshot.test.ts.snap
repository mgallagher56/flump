          "pattern": "^(19|2[01])\\d{2}-(0[1-9]|1[0-2])$",
          "type": "string",
        },
        "groupBy": {
          "default": "total",
          "description": "One series per account, per category, or one net-worth total (default)",
          "enum": [
            "account",
            "category",
            "total",
          ],
          "type": "string",
        },
        "interval": {
          "default": "month",
          "enum": [
            "month",
            "quarter",
            "year",
          ],
          "type": "string",
