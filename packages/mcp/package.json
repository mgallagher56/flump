{
  "name": "@flump/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "flump-mcp": "./dist/transports/stdio.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./transports/http": {
      "types": "./dist/transports/http.d.ts",
      "import": "./dist/transports/http.js",
      "default": "./src/transports/http.ts"
    },
    "./transports/stdio": {
      "types": "./dist/transports/stdio.d.ts",
      "import": "./dist/transports/stdio.js",
      "default": "./src/transports/stdio.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@flump/finance-engine": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
