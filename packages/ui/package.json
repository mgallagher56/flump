{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.tsx",
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./src/fonts/fonts.css",
    "./styled-system/css": "./styled-system/css/index.js",
    "./styled-system/jsx": "./styled-system/jsx/index.js",
    "./styled-system/patterns": "./styled-system/patterns/index.js",
    "./styled-system/recipes": "./styled-system/recipes/index.js",
    "./styled-system/tokens": "./styled-system/tokens/index.js",
    "./styled-system/*": "./styled-system/*",
    "./preset": "./panda.preset.ts",
    "./calculators": "./src/calculators/index.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "generate": "panda codegen",
    "prepare": "panda codegen",
    "build": "bun run generate && tsc",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@pandacss/preset-panda": "2.5.0",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "dependencies": {
    "@flump/finance-engine": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "lucide-react": "1.72.0",
    "react-icons": "5.7.0"
  }
}
