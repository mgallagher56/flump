{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["src", "styled-system"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.tsx",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
