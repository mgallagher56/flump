{
  "name": "@flump/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.generated.d.ts",
      "module": "./src/native.generated.ts",
      "import": "./dist/native.generated.js",
      "default": "./dist/native.generated.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate:tokens": "bun scripts/build-native-tokens.ts",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
