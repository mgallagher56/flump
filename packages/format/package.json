{
  "name": "@flump/format",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "module": "./src/fixtures.ts",
      "import": "./dist/fixtures.js",
      "default": "./dist/fixtures.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run && bun test ./src/fixtures.bun.test.ts",
    "test:coverage": "vitest run --coverage && bun test ./src/fixtures.bun.test.ts"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
