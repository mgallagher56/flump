{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/backend": {
      "entry": ["src/data-source.ts", "src/migrations/*.ts", "src/scripts/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@nestjs/schematics", "@typescript/typescript6"]
    },
    "apps/web": {
      "react-router": false,
      "vite": false,
      "ignoreDependencies": ["@react-router/remix-routes-option-adapter", "remix-flat-routes"]
    },
    "packages/ui": {
      "ignoreDependencies": [
        "@fontsource-variable/inter",
        "@fontsource-variable/plus-jakarta-sans",
        "@repo/typescript-config",
        "react-icons"
      ]
    },
    "packages/*": {
      "ignoreDependencies": ["@repo/typescript-config"]
    }
  }
}
