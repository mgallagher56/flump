{
  "name": "flump",
  "version": "1.18.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@nestjs/core": "12.4.2",
    "@nestjs/common": "12.4.2",
    "@nestjs/platform-express": "12.4.2"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write .",
    "test": "turbo run test && bun test ./scripts",
    "test:e2e": "bun run --cwd apps/e2e e2e",
    "test:visual": "bun run --cwd apps/e2e e2e:visual",
    "test:a11y": "bun run --cwd apps/e2e e2e:a11y",
    "test:scripts": "bun test ./scripts",
    "test:coverage": "turbo run test:coverage",
    "test:storybook": "bun run --cwd apps/web test:storybook",
    "test:storybook:dark": "bun run --cwd apps/web test:storybook:dark",
    "check-types": "turbo run check-types",
    "check:auth": "bash scripts/check-no-mock-auth.sh",
    "check:audit": "bun scripts/check-audit.ts",
    "check:tax-calendar": "bun scripts/check-tax-year-calendar.ts",
    "check:launch": "bun scripts/check-launch-readiness.ts",
    "tax:signoff": "bun scripts/tax-signoff.ts",
    "check:laws": "bun scripts/check-design-tokens.ts && bun scripts/check-tabular-nums.ts && bun scripts/check-react-icons.ts && bun scripts/check-style-literals.ts && bun scripts/check-input-types.ts && bun scripts/check-judgement-tokens.ts && bun scripts/check-dependency-versions.ts && bun scripts/check-copy.ts && bun scripts/check-backend-laws.ts",
    "verify": "turbo run verify",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/parser": "7.29.13",
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
