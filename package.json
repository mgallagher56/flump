{
  "name": "flump",
  "version": "1.18.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@nestjs/core": "12.4.1",
    "@nestjs/common": "12.4.1",
    "@nestjs/platform-express": "12.4.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check --write .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:storybook": "bun run --cwd apps/web test:storybook",
    "check-types": "turbo run check-types",
    "verify": "turbo run verify",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "biome check --write"
    ]
  }
}
