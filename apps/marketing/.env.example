PORT=3001
NODE_ENV=development

# Search indexing. Default (unset): every response sends X-Robots-Tag: noindex, nofollow and
# /robots.txt serves "Disallow: /". Set to exactly `true` to allow indexing (header dropped,
# robots.txt serves "Allow: /"); any other value ("1", "TRUE", ...) stays noindex.
# Release 368 flips production to noindex by default: only set this when you want to be indexed.
# ALLOW_INDEXING=true

# Launch guard (E24-T1). Set to exactly `true` at launch: the production build then fails if the
# output still contains placeholder text (PLACEHOLDER, example.invalid, £X/£Y, unowned domains).
# Unset or any other value: the guard does nothing. In Docker/Railway it is a build arg.
# FLUMP_LAUNCH=true
