PORT=3001
NODE_ENV=development

# Indexing needs BOTH ALLOW_INDEXING=true and FLUMP_LAUNCH=true (E24-T6). Either one alone stays
# noindex and logs a warning at boot.
# Search indexing. Default (unset): every response sends X-Robots-Tag: noindex, nofollow and
# /robots.txt serves "Disallow: /". Set to exactly `true` to allow indexing (header dropped,
# robots.txt serves "Allow: /"); any other value ("1", "TRUE", ...) stays noindex.
# Release 368 flips production to noindex by default: only set this when you want to be indexed.
# ALLOW_INDEXING=true

# Launch guard (E24-T1). Set to exactly `true` at launch: the production build then fails if the
# output still contains placeholder text (PLACEHOLDER, example.invalid, £X/£Y, unowned domains).
# Unset or any other value: the guard does nothing. In Docker/Railway it is a build arg.
# FLUMP_LAUNCH=true

# Public site origin (https only), e.g. https://flump.example. When set, every page gets
# <link rel="canonical"> (query stripped); when indexing is allowed robots.txt adds a Sitemap line
# and /sitemap.xml is served. Leave unset until the domain exists: no canonical, sitemap is a 404.
# SITE_URL=

# Cookieless page counts (E24-T9). Off by default. Enabled only when BOTH are set: ANALYTICS_MODE
# exactly `log` and ANALYTICS_NOTICE_URL, the published https cookie and storage statement (E19 C3).
# Counts GET HTML navigations only, one JSON log line per view:
# {"type":"pageview","key":"/pricing","ref":"host-or-null","day":"YYYY-MM-DD"}
# No cookie, no IP, no user agent, no query string, bots dropped. Summarise exported Railway logs with
# `railway logs | bun scripts/ops/pageview-rollup.ts` (Hobby keeps logs for 7 days: run it weekly).
# ANALYTICS_MODE=log
# ANALYTICS_NOTICE_URL=
