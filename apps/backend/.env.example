PORT=4000
BACKEND_URL=http://localhost:4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=flump
JWT_SECRET=supersecretdevkey
WORKOS_API_KEY=your_workos_api_key
WORKOS_CLIENT_ID=your_workos_client_id
WORKOS_REDIRECT_URI=http://localhost:5173/callback
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# Authentication fails closed. WORKOS_CLIENT_ID is REQUIRED: the backend verifies
# WorkOS access tokens against its JWKS and refuses to start without it.
# AUTH_DEV_BYPASS=true is a DEV-ONLY escape hatch (accepts the mock session token).
# It also requires NODE_ENV=development and no WORKOS_API_KEY; any other
# environment (including production) refuses to start with it set.
# AUTH_DEV_BYPASS=true
#
# The accepted token issuer is derived as
# https://api.workos.com/user_management/<WORKOS_CLIENT_ID> (logged at boot).
# WORKOS_ISSUER (optional) is ONE exact https URL that replaces it, for custom
# auth domains. An invalid value fails boot.
# WORKOS_ISSUER=

# Every variable below is checked once at boot against one schema (src/config/env.schema.ts). A
# malformed value, or a production-required one that is missing, stops boot with an error that names
# the variable (never its value). Required when NODE_ENV=production: DATABASE_URL (or DB_HOST),
# CORS_ALLOWED_ORIGINS, MCP_AUDIT_HMAC_KEY, WORKOS_CLIENT_ID, BANKING_TOKEN_ENCRYPTION_KEY, plus a beta
# allow-list or BETA_OPEN=true (see below).
#
# NODE_ENV: only "development" and "test" are relaxed. Anything else, including
# unset, is strict (production rules). Set it explicitly in every deployment.
NODE_ENV=development

# Database. Alternatively set DATABASE_URL (postgres://user:pass@host:5432/name);
# the app splits it into host, port, user, password and database, and any query
# string on it (for example ?sslmode=require) is IGNORED. Use DB_SSL for TLS.
# DATABASE_URL=
#
# DB_SSL: unset = verify the server certificate for non-local hosts and no TLS for
# localhost; true = force TLS with verification; false = no TLS;
# no-verify = TLS WITHOUT certificate verification (explicit opt-out, logs a warning).
# false disables TLS entirely (a remote host logs a warning): only for a local or
# private-network database.
# DB_SSL=
# DB_SSL_CA is an optional PEM CA certificate for a self-signed or private CA. It only
# applies when TLS is on.
# DB_SSL_CA=
#
# Development/test do NOT create tables on boot. Run `NODE_ENV=development bun run
# migration:run` once from apps/backend, or set DB_SYNCHRONIZE=true for a throwaway
# schema sync.
# DB_SYNCHRONIZE=true lets TypeORM auto-alter the schema. Development/test ONLY:
# in strict mode it makes the backend refuse to start. Production uses migrations
# (run automatically on boot); see the README "Migrations" section.
# DB_SYNCHRONIZE=false
#
# Connection pool and session limits (all optional; unset uses the default shown).
# Requests fail fast instead of queueing forever when the database is slow or locked.
# DB_POOL_MAX is per process: keep DB_POOL_MAX x replicas well below the server's
# max_connections (check it on the database host before raising this).
# DB_POOL_MAX=10
# Wait for a free pooled connection before the request fails (ms).
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# Close a pooled connection after it has been unused this long (ms).
# DB_POOL_IDLE_TIMEOUT_MS=30000
# Postgres cancels any statement running longer than this (ms). Also applies to
# migrations at boot; a migration that needs longer lifts it for its own session.
# DB_STATEMENT_TIMEOUT_MS=10000
# Postgres gives up waiting for a row or table lock after this (ms). Must be lower
# than DB_STATEMENT_TIMEOUT_MS.
# DB_LOCK_TIMEOUT_MS=5000
# Postgres ends a session whose transaction sits open and idle this long (ms).
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# Slow-query log: a query running longer than this (ms) is logged with its SQL text (never its
# parameters) through the scrubbing logger.
# DB_SLOW_QUERY_MS=500

# Bank-token encryption key. REQUIRED outside development/test and must be at least
# 32 characters; the backend refuses to start without it. Generate one with:
#   openssl rand -hex 32
# Keep it stable: changing it makes stored bank tokens undecryptable (users must reconnect).
# BANKING_TOKEN_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
# Key rotation (docs/runbooks/bank-token-key-rotation.md): a versioned list, the first entry
# encrypts and every entry decrypts. Unset means BANKING_TOKEN_ENCRYPTION_KEY is version 1.
# BANKING_TOKEN_ENCRYPTION_KEYS=2:CHANGE_ME_new_key,1:CHANGE_ME_old_key

# Bank OAuth redirect URI (required for an OAuth bank connection; there is no localhost
# fallback). Per institution, or derived from BACKEND_URL as <BACKEND_URL>/bank-connections/callback.
# MONZO_REDIRECT_URI=https://api.example.com/bank-connections/callback

# Account deletion tombstone key (BE-04): HMAC key for the hashed user id kept after an account is
# erased. At least 32 characters. Without it, outside development/test (or on Railway), account
# deletion answers 503; every other route keeps working. Generate one with:
#   openssl rand -hex 32
# NEVER ROTATE IT: old tombstones become unfindable, which breaks deletion retries and lets an
# erased account's still-valid tokens through.
# DELETION_TOMBSTONE_KEY=CHANGE_ME_openssl_rand_hex_32

# Bank connection is owner-only (E19). Comma-separated WorkOS user ids allowed to connect banks.
# Unset means nobody in production. BANK_CONNECTIONS_ENABLED=true opens it to every user and is
# refused at boot (BankLaunchGateError) until the bank launch gate in src/config/launch-gate.ts
# passes; unset it is off in production and on elsewhere.
# BANK_CONNECTIONS_ALLOWED_USER_IDS=user_01EXAMPLE
# BANK_CONNECTIONS_ENABLED=false

# MCP and personal access tokens are owner-only (E29-T8). Comma-separated WorkOS user ids that may
# create tokens, download the context pack and use existing tokens.
# MCP_ALLOWED_USER_IDS=user_01EXAMPLE
# MCP_OPEN_ACCESS=true opens MCP to every user. Leave unset in production and on Railway (closed
# to everyone but the allowlist); unset elsewhere it is open and the backend logs a warning.
# Set true only after the MCP DPIA (E29-T9) is signed.
# MCP_OPEN_ACCESS=false
# Global kill switch (E20-N18). MCP_ENABLED=false answers 503 and disables all tokens. Do not set
# it to restrict access; use MCP_ALLOWED_USER_IDS for that.
# MCP_ENABLED=true
# Browser origins allowed to call /mcp (E20-N18), comma-separated, e.g. https://app.example.com.
# Read once at boot: changing it needs a restart/redeploy (MCP_ENABLED is read per request).
# Use exact origins with scheme (and port if any); "*" and "null" are not supported and log a warning.
# Unset or empty rejects every request that carries an Origin header with 403. Requests without an
# Origin (Claude/ChatGPT connectors, CLIs) are always allowed past this check and still need a PAT.
# MCP_ALLOWED_ORIGINS=
# Agent audit trail (E17-N17): HMAC-SHA256 key for the argument fingerprint on each audit row.
# Unset stores no fingerprint (logged at boot). REQUIRED in production, at least 32 characters
# (openssl rand -hex 32). Never commit a real one.
# MCP_AUDIT_HMAC_KEY=replace-with-a-long-random-value
# Signed client IP (BE-07, M9): HMAC key shared with the web service (same value on both). The web
# server signs each browser's address so the per-IP rate limit keys on it instead of the web
# server's own IP. Unset or under 32 characters, web users share one per-IP bucket. Never commit a
# real one (openssl rand -hex 32).
# WEB_CLIENT_IP_HMAC_KEY=replace-with-a-long-random-value
# Web app origin for MCP import review links (E17 re-plan PR D): reviewUrl is
# ${WEB_ORIGIN}/app/imports/<batchId>. A bare http(s) origin, no path. Unset falls back to
# http://localhost:5173 outside production and to a relative path in production (with a warning).
# WEB_ORIGIN=https://app.example.com

# Closed beta allowlist (E19). When either is set, only listed accounts may use the API;
# neither set means unrestricted. Emails are case-insensitive and need an email claim in the
# access token; user ids work without it. In production, neither set refuses boot
# (OpenBetaNotConfirmedError) unless BETA_OPEN=true confirms the open beta is deliberate.
# BETA_ALLOWED_EMAILS=you@example.com,friend@example.com
# BETA_ALLOWED_USER_IDS=user_01EXAMPLE
# BETA_OPEN=false

# Request validation against @flump/api-contract (E21). enforce (default) answers 400 for invalid
# params/query/body (unknown keys are never rejected); shadow logs mismatches only; off disables.
# Response shapes are checked and logged in every mode except off, never rejected.
# Production refuses anything but enforce at boot (ContractModeNotEnforcedError).
# CONTRACT_MODE=enforce
# Comma-separated contract groups to enforce (accounts,budget,tax,profile,bank-connections,
# transactions,snapshots,mcp-tokens,app). Unset = all groups.
# CONTRACT_ENFORCE_GROUPS=

# Sentry (optional; inert without a DSN). Traces: 2% sample in production, none elsewhere; each
# trace is one request span named by route template, with no URL, query, headers, cookies or body.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_TRACES_SAMPLE_RATE=0.02
# Log output: json (default in production) or text.
# LOG_FORMAT=

# Mobile client versions served by GET /v1/app/client-policy (public, read before sign-in).
# A client below MIN must update; one below RECOMMENDED is offered an update. Unset or malformed
# means no minimum (0.0.0). Use dotted numbers such as 1.4.0.
# CLIENT_POLICY_IOS_MIN_VERSION=0.0.0
# CLIENT_POLICY_IOS_RECOMMENDED_VERSION=0.0.0
# CLIENT_POLICY_ANDROID_MIN_VERSION=0.0.0
# CLIENT_POLICY_ANDROID_RECOMMENDED_VERSION=0.0.0
