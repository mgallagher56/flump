PORT=4000
BACKEND_URL=http://localhost:4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=flump
JWT_SECRET=supersecretdevkey
WORKOS_API_KEY=your_workos_api_key
WORKOS_CLIENT_ID=your_workos_client_id
WORKOS_REDIRECT_URI=http://localhost:5173/callback
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# Authentication fails closed. WORKOS_CLIENT_ID is REQUIRED: the backend verifies
# WorkOS access tokens against its JWKS and refuses to start without it.
# AUTH_DEV_BYPASS=true is a DEV-ONLY escape hatch (accepts the mock session token).
# It also requires NODE_ENV=development and no WORKOS_API_KEY; any other
# environment (including production) refuses to start with it set.
# AUTH_DEV_BYPASS=true
#
# WORKOS_ISSUER (optional, comma-separated) lists the accepted token issuers and
# REPLACES the defaults (https://api.workos.com and
# https://api.workos.com/user_management/<WORKOS_CLIENT_ID>). Use it for custom
# auth domains. Decode one real access token and check its `iss` before first deploy.
# WORKOS_ISSUER=
NODE_ENV=development
