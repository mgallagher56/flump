{
  "name": "backend",
  "version": "1.27.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "biome check --write .",
    "start": "node dist/main",
    "start:dev": "NODE_ENV=development bun --watch src/main.ts",
    "start:prod": "node dist/main",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "migration:run": "bun ./node_modules/typeorm/cli.js -d src/data-source.ts migration:run",
    "migration:revert": "bun ./node_modules/typeorm/cli.js -d src/data-source.ts migration:revert",
    "migration:generate": "bun ./node_modules/typeorm/cli.js -d src/data-source.ts migration:generate"
  },
  "dependencies": {
    "@flump/api-contract": "workspace:*",
    "@flump/banking": "workspace:*",
    "@flump/finance-engine": "workspace:*",
    "@flump/mcp": "workspace:*",
    "@flump/observability": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/typeorm": "12.0.3",
    "@sentry/node": "10.78.0",
    "@workos-inc/node": "12.2.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@typescript/typescript6": "6.0.2",
    "supertest": "7.3.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
