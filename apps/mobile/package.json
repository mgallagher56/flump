{
  "name": "@flump/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "biome check .",
    "typegen": "expo customize tsconfig.json",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "export": "expo export --platform ios --platform android --output-dir dist --source-maps --clear",
    "check:bundle": "bun ../../scripts/check-mobile-bundle.ts dist",
    "doctor": "bun ../../scripts/run-expo-doctor.ts",
    "doctor:raw": "expo-doctor"
  },
  "dependencies": {
    "@babel/runtime": "7.29.13",
    "@flump/api-client": "workspace:*",
    "@flump/api-contract": "workspace:*",
    "@flump/business-details": "workspace:*",
    "@flump/finance-engine": "workspace:*",
    "@flump/format": "workspace:*",
    "@flump/tokens": "workspace:*",
    "@tanstack/react-query": "5.108.0",
    "expo": "58.0.26",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-dev-client": "58.0.21",
    "expo-file-system": "58.0.14",
    "expo-linking": "58.0.17",
    "expo-local-authentication": "58.0.3",
    "expo-network": "58.0.5",
    "expo-router": "58.0.32",
    "expo-screen-capture": "58.0.6",
    "expo-secure-store": "58.0.3",
    "expo-sharing": "58.0.23",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-web-browser": "58.1.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@react-native/jest-preset": "0.88.1",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "babel-jest": "30.5.2",
    "expo-doctor": "1.21.8",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "typescript": "7.0.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-masked-view/masked-view"
        ]
      }
    },
    "install": {
      "exclude": [
        "react",
        "typescript"
      ]
    },
    "autolinking": {
      "exclude": [
        "expo-dev-client",
        "expo-dev-launcher",
        "expo-dev-menu",
        "expo-dev-menu-interface"
      ]
    }
  }
}
