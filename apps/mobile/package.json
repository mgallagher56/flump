{
  "name": "@flump/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "export": "expo export --platform ios --platform android --output-dir dist --source-maps --clear",
    "check:bundle": "bun ../../scripts/check-mobile-bundle.ts dist",
    "doctor": "bun ../../scripts/run-expo-doctor.ts",
    "doctor:raw": "expo-doctor"
  },
  "dependencies": {
    "@babel/runtime": "7.29.13",
    "@flump/finance-engine": "workspace:*",
    "@flump/format": "workspace:*",
    "@flump/tokens": "workspace:*",
    "expo": "58.0.26",
    "expo-constants": "58.0.16",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.32",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@flump/api-client": "workspace:*",
    "@flump/api-contract": "workspace:*",
    "@react-native/jest-preset": "0.88.1",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "expo-doctor": "1.21.8",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "typescript": "7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "typescript"
      ]
    }
  }
}
