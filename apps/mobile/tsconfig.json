{
  "extends": ["expo/tsconfig.base", "@repo/typescript-config/expo.json"],
  "compilerOptions": {
    // expo/types is listed here, not left to the gitignored expo-env.d.ts that `expo start` writes,
    // so CI type-checks against the same declarations as a developer's machine.
    "types": ["jest", "node", "expo/types"],
    // The document pictures' shape lists (STYLE-GUIDE IL4): one pure-data file from packages/ui,
    // mapped by path rather than a dependency on @repo/ui, whose react-dom peer expo-doctor rejects.
    // Expo's Metro reads these paths too (CROSS-PLATFORM X2).
    "paths": {
      "@repo/ui/illustration-data": [
        "../../packages/ui/src/primitives/Illustration/Illustration.documents.ts"
      ]
    }
  },
  // .expo/types holds the typed-route declarations. The `typegen` script (`expo customize`, no
  // Metro) writes them, and turbo runs it before this app's check-types and test (turbo.json here).
  // typeDeclarations.test.ts fails if either declaration source goes missing.
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
