# Copy to .env.local in the MAIN checkout's apps/mobile (not a session worktree, which is removed
# when its session ends), then fill in the staging values. All three are public configuration that
# Expo puts in the app bundle: never put a secret or a WorkOS API key here.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_WORKOS_CLIENT_ID=client_replace_with_the_staging_client_id
EXPO_PUBLIC_MARKETING_URL=https://www.example.com
# Optional (E12 S4): the web app, where pages the app does not have yet open. Without it they open
# the marketing site's home page.
EXPO_PUBLIC_WEB_APP_URL=https://app.flump.example
