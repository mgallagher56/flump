{
  "name": "@flump/web",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "version": "1.28.0",
  "dependencies": {
    "@flump/banking": "workspace:*",
    "@flump/finance-engine": "workspace:*",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "@repo/ui": "workspace:*",
    "@workos-inc/authkit-react-router": "0.13.0",
    "cross-env": "10.1.0",
    "d3-shape": "3.2.1",
    "i18next": "26.7.2",
    "i18next-fs-backend": "2.6.10",
    "i18next-http-backend": "4.0.10",
    "isbot": "5.2.2",
    "jotai": "3.0.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "react-icons": "5.7.0",
    "react-router": "7.18.5",
    "recharts": "3.10.1",
    "remix-i18next": "7.5.0",
    "tiny-invariant": "1.3.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@pandacss/preset-panda": "2.5.0",
    "@react-router/dev": "7.18.5",
    "@react-router/remix-routes-option-adapter": "7.18.5",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-mcp": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "autoprefixer": "10.6.2",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "playwright": "1.65.0",
    "postcss": "8.5.32",
    "remix-flat-routes": "0.8.5",
    "rollup-plugin-visualizer": "7.1.2",
    "storybook": "10.6.6",
    "vite": "8.3.6",
    "vite-plugin-checker": "0.14.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0",
    "vitest-sonar-reporter": "3.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && bun ../../scripts/check-launch-placeholders.ts build",
    "start": "react-router-serve ./build/server/index.js",
    "format": "biome check --write .",
    "lint": "biome check .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:ui": "vitest --ui --project unit",
    "typecheck": "react-router typegen && tsc",
    "check-types": "bun run typecheck",
    "prepare": "panda codegen && react-router typegen",
    "storybook": "cross-env STORYBOOK=true STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "cross-env STORYBOOK=true STORYBOOK_DISABLE_TELEMETRY=1 storybook build --disable-telemetry",
    "build-storybook:test": "cross-env STORYBOOK=true STORYBOOK_DISABLE_TELEMETRY=1 storybook build --test --disable-telemetry",
    "test:storybook": "cross-env STORYBOOK=true STORYBOOK_DISABLE_TELEMETRY=1 VITE_SB_THEME=light vitest run --project storybook",
    "test:storybook:dark": "cross-env STORYBOOK=true STORYBOOK_DISABLE_TELEMETRY=1 VITE_SB_THEME=dark vitest run --project storybook"
  },
  "lint-staged": {
    "app/**/*.{js,jsx,ts,tsx,json,css,md}": "biome check --write"
  },
  "typeCoverage": {
    "atLeast": "100.00",
    "ignoreFiles": [
      "app/**/*.config.{js,ts,jsx,tsx}",
      "app/*.*",
      "app/components/ui/*.*",
      "*.*",
      "app/**/*.test.{js,ts,jsx,tsx}",
      "styled-system/**/*.*",
      "test/**/*.{js,ts,jsx,tsx}",
      "app/utils/utils.ts",
      "app/**/*.d.ts"
    ]
  }
}
