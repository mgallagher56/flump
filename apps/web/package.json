{
  "name": "@flump/web",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "version": "1.22.2",
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@react-router/node": "7.18.3",
    "@react-router/serve": "7.18.3",
    "@repo/common": "workspace:*",
    "@repo/ui": "workspace:*",
    "@workos-inc/authkit-react-router": "0.11.0",
    "cross-env": "10.1.0",
    "d3-shape": "3.2.0",
    "i18next": "26.4.1",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-fs-backend": "2.6.7",
    "i18next-http-backend": "4.0.2",
    "isbot": "5.2.2",
    "jotai": "2.20.3",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "react-icons": "5.7.0",
    "react-router": "7.17.0",
    "recharts": "3.10.1",
    "remix-i18next": "7.5.0",
    "tiny-invariant": "1.3.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@pandacss/dev": "1.12.0",
    "@react-router/dev": "7.18.3",
    "@react-router/fs-routes": "7.18.3",
    "@react-router/remix-routes-option-adapter": "7.18.3",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "0.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "autoprefixer": "10.5.4",
    "c8": "11.0.0",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "happy-dom": "20.13.2",
    "msw": "2.15.0",
    "playwright": "1.63.0",
    "postcss": "8.5.15",
    "remix-flat-routes": "0.8.5",
    "rollup-plugin-visualizer": "7.1.1",
    "storybook": "10.6.0",
    "tsc-files": "1.1.4",
    "tsconfig-paths": "4.2.0",
    "typescript-coverage-report": "1.1.1",
    "vite": "8.2.2",
    "vite-plugin-checker": "0.14.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11",
    "vitest-github-actions-reporter": "0.11.1",
    "vitest-sonar-reporter": "3.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "format": "biome check --write .",
    "lint": "biome check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "react-router typegen && tsc",
    "check-types": "bun run typecheck",
    "prepare": "panda codegen && react-router typegen",
    "storybook": "cross-env STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "cross-env STORYBOOK=true storybook build"
  },
  "lint-staged": {
    "app/**/*.{js,jsx,ts,tsx,json,css,md}": "biome check --write"
  },
  "typeCoverage": {
    "atLeast": "100.00",
    "ignoreFiles": [
      "app/**/*.config.{js,ts,jsx,tsx}",
      "app/*.*",
      "app/components/ui/*.*",
      "*.*",
      "app/**/*.test.{js,ts,jsx,tsx}",
      "styled-system/**/*.*",
      "test/**/*.{js,ts,jsx,tsx}",
      "app/utils/utils.ts",
      "app/**/*.d.ts"
    ]
  }
}
