  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "format": "biome check --write .",
    "lint": "biome check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "react-router typegen && tsc",
    "check-types": "bun run typecheck",
    "prepare": "panda codegen && react-router typegen"
  },
  "lint-staged": {
    "app/**/*.{js,jsx,ts,tsx,json,css,md}": "biome check --write"
  },
  "typeCoverage": {
    "atLeast": "100.00",
    "ignoreFiles": [
      "app/**/*.config.{js,ts,jsx,tsx}",
      "app/*.*",
      "app/components/ui/*.*",
      "*.*",
      "app/**/*.test.{js,ts,jsx,tsx}",
      "styled-system/**/*.*",
      "test/**/*.{js,ts,jsx,tsx}",
      "app/utils/utils.ts",
      "app/**/*.d.ts"
    ]
  }
