VITE_WORKOS_CLIENT_ID=your_workos_client_id
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback
VITE_API_URL=http://localhost:3000

# Auth. WORKOS_CLIENT_ID is required in production (backend refuses to boot without it).
# AUTH_DEV_BYPASS is for local development only: needs NODE_ENV=development and is
# refused in production at startup. Do not combine with WORKOS_API_KEY.
# AUTH_DEV_BYPASS=true
