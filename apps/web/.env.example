VITE_WORKOS_CLIENT_ID=your_workos_client_id
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback
VITE_API_URL=http://localhost:4000

# Auth. WORKOS_CLIENT_ID is required in production (backend refuses to boot without it).
# AUTH_DEV_BYPASS is for local development only: needs NODE_ENV=development and is
# refused in production at startup. Do not combine with WORKOS_API_KEY.
# AUTH_DEV_BYPASS=true
# E2E_DEV_SESSION=true is for the Playwright suite (apps/e2e) only: /login sets a dev session cookie
# and /logout clears it. Needs AUTH_DEV_BYPASS=true and NODE_ENV=development; any other
# environment, RAILWAY_ENVIRONMENT or WORKOS_API_KEY makes the server refuse to start with it set.
# E2E_DEV_SESSION=true
# Session cookie policy (E20-N19). Boot defaults WORKOS_COOKIE_MAX_AGE to 1209600 (14 days);
# production refuses to boot above that, or with a non-https WORKOS_REDIRECT_URI.
# WORKOS_COOKIE_NAME defaults to `__Host-wos-session` in production only (needs Secure, so it
# cannot work over http); dev and test keep `wos-session`. Leave both unset unless overriding.
# WORKOS_COOKIE_MAX_AGE=1209600
# WORKOS_COOKIE_NAME=__Host-wos-session


# Search indexing. Default (unset): every response sends X-Robots-Tag: noindex, nofollow and
# /robots.txt serves "Disallow: /". Set to exactly `true` to allow indexing (header dropped,
# robots.txt serves "Allow: /"); any other value ("1", "TRUE", ...) stays noindex.
# Release 368 flips production to noindex by default: only set this when you want to be indexed.
# ALLOW_INDEXING=true

# Launch guard (E24-T1). Set to exactly `true` at launch: the production build then fails if the
# output still contains placeholder text (PLACEHOLDER, example.invalid, £X/£Y, unowned domains) or
# packages/business-details still has an isPlaceholder field. ALLOW_INDEXING=true also activates it.
# Unset or any other value: the guard does nothing. In Docker/Railway it is a build arg.
# FLUMP_LAUNCH=true

# Content Security Policy (BE-07, M8). The full nonce policy is ENFORCED on every HTML document.
# Rollback only: set to exactly `true` to send it as Content-Security-Policy-Report-Only again.
# CSP_REPORT_ONLY=true

# Browser source maps to Sentry (BE-07, L14). Build time only, all three needed: the client build
# then emits hidden source maps, uploads them and deletes them, so they are never served. Leave
# unset for local and CI builds (no maps, no upload). In Docker/Railway the org, project and URL
# are build args; the token is a BuildKit secret (id SENTRY_AUTH_TOKEN), never a build arg.
# SENTRY_AUTH_TOKEN=sntrys_your_org_token
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-web-project
# Optional, for a self-hosted or region-specific Sentry:
# SENTRY_URL=https://de.sentry.io/

# Signed client IP (BE-07, M9): HMAC key shared with the backend (same value on both). Signs each
# browser's address on backend calls so the backend's per-IP rate limit keys on it. Unset or under
# 32 characters, no header is sent. Never commit a real one (openssl rand -hex 32).
# WEB_CLIENT_IP_HMAC_KEY=replace-with-a-long-random-value
