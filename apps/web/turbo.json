{
  // The commit sha is part of the build env on purpose: it is embedded as the app version, so a
  // new commit must not reuse a cached web build. Only this app is affected, not package builds.
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["$TURBO_EXTENDS$", "RAILWAY_GIT_COMMIT_SHA", "GITHUB_SHA", "VITE_APP_VERSION"]
    },
    // The web contract suite (app/contract) boots apps/backend/src/main.ts, which imports the
    // built workspace packages the backend depends on. Declare that so the web shard builds them
    // (backend#build builds those dependencies first) without the backend's own tests.
    "test:coverage": {
      "dependsOn": ["$TURBO_EXTENDS$", "backend#build"]
    }
  }
}
