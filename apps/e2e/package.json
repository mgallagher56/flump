{
  "name": "@flump/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end smoke suite (runs against built backend, web and marketing apps)",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "e2e:visual": "playwright test -c playwright.visual.config.ts",
    "e2e:a11y": "playwright test -c playwright.a11y.config.ts",
    "e2e:sweep": "playwright test -c playwright.sweep.config.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
