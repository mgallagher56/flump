{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/.turbo",
      "!**/.next",
      "!**/build",
      "!**/styled-system",
      "!**/CHANGELOG.md",
      "!docs/audit",
      "!docs/design/**/*.html"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/marketing/src/index.css", "apps/web/src/index.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/backend/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          },
          "suspicious": {
            "noExplicitAny": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/backend/**",
        "packages/api-contract/**",
        "packages/banking/**",
        "packages/finance-engine/**",
        "packages/mcp/**",
        "packages/observability/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "error",
            "noUnusedImports": "error",
            "noUnusedFunctionParameters": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "error",
              "options": { "skip": ["Button"] }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/mobile/app/**",
        "apps/mobile/src/**",
        "!apps/mobile/src/components/**",
        "!apps/mobile/src/data/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native": {
                    "importNames": ["Text", "Pressable", "TextInput"],
                    "message": "Use the app's own Text, Pressable or input from src/components (E12 S1b): they keep text scalable, targets 48pt and controls named."
                  },
                  "@flump/api-client": "Only src/data talks to the API (O5 seam 2, plan section 4.6)."
                }
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Only src/data talks to the API (O5 seam 2, plan section 4.6)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@flump/api-client": "Only src/data talks to the API (O5 seam 2, plan section 4.6)."
                }
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Only src/data talks to the API (O5 seam 2, plan section 4.6)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/src/data/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native": {
                    "importNames": ["Text", "Pressable", "TextInput"],
                    "message": "Use the app's own Text, Pressable or input from src/components (E12 S1b)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/app/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": {
                "allow": ["warn", "error"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/app/**/*.stories.tsx",
        "apps/web/app/**/*.stories.ts",
        "apps/web/app/**/*.test.tsx",
        "apps/web/app/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "noAlert": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "noUnusedVariables": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "a11y": {
        "preset": "recommended",
        "useAltText": "error",
        "useAriaPropsForRole": "error",
        "useButtonType": "error",
        "useKeyWithClickEvents": "error",
        "useValidAriaRole": "error",
        "noSvgWithoutTitle": "error",
        "useAnchorContent": "error",
        "useFocusableInteractive": "error",
        "noStaticElementInteractions": "error",
        "useSemanticElements": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  }
}
