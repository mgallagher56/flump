{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "scripts/ops/backup.Dockerfile",
    "watchPatterns": ["scripts/ops/backup*"]
  },
  "deploy": {
    "startCommand": "bun scripts/ops/backup-run.ts",
    "cronSchedule": "30 2 * * *",
    "restartPolicyType": "NEVER"
  }
}
