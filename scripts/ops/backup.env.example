# Variables for the backup cron service (scripts/ops/backup.railway.json) and for running
# scripts/ops/backup-run.ts / backup-restore.ts by hand. Placeholders only: real values live in
# the Railway service's variables or your own shell, never in the repository.

# Backup (backup-run.ts)
BACKUP_DATABASE_URL=${{Postgres.DATABASE_URL}}
BACKUP_DESTINATION=s3://<bucket>/flump/prod
BACKUP_AGE_RECIPIENTS=age1<primary-public-key>,age1<offline-recovery-public-key>
BACKUP_LABEL=prod
BACKUP_HEARTBEAT_URL=https://<heartbeat-check-url>
BACKUP_HEARTBEAT_FAIL_URL=https://<heartbeat-check-url>/fail

# S3-compatible storage (offsite: a different provider from Railway)
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=<write-only key id>
S3_SECRET_ACCESS_KEY=<write-only key secret>

# Restore (backup-restore.ts), on your own machine only
RESTORE_DATABASE_URL=postgres://postgres:drill_local_only@127.0.0.1:55433/flump_drill
BACKUP_AGE_IDENTITY_FILE=/path/to/age-identity.txt
