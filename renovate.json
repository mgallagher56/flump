{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":pinAllExceptPeerDependencies",
    "security:minimumReleaseAgeNpm",
    "schedule:earlyMondays"
  ],
  "ignoreDeps": ["typescript-coverage-report"],
  "baseBranchPatterns": ["main"],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "7 days",
  "timezone": "Europe/London",
  "packageRules": [
    {
      "description": "E36 2(a): 7-day release-age gate for npm packages (overrides security:minimumReleaseAgeNpm's 3-day preset)",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major third-party dependencies",
      "automerge": false,
      "matchPackageNames": ["*"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "The visual regression job's container image must match @playwright/test, and a bump means regenerating its baselines (apps/e2e/README.md)",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "playwright",
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "E12 S1a: an Expo SDK pins React, React Native and its native modules together, so they move as one group and only to the versions the SDK lists (check with expo-doctor in apps/mobile)",
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "jest-expo",
        "react-native",
        "react-native-*",
        "@react-native/*",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "expo sdk and react",
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "The Playwright image tag is v<semver>-<ubuntu codename>",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mcr.microsoft.com/playwright"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>.+)$"
    }
  ]
}
