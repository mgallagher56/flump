{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":pinAllExceptPeerDependencies",
    "security:minimumReleaseAgeNpm",
    "schedule:earlyMondays"
  ],
  "ignoreDeps": ["typescript-coverage-report"],
  "baseBranchPatterns": ["main"],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "timezone": "Europe/London",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major third-party dependencies",
      "automerge": false,
      "matchPackageNames": ["*"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "The visual regression job's container image must match @playwright/test, and a bump means regenerating its baselines (apps/e2e/README.md)",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "playwright",
      "automerge": false
    }
  ]
}
