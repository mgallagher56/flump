{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "outputs": ["styled-system/**"],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "env": ["FLUMP_LAUNCH", "ALLOW_INDEXING"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types", "generate", "^generate"]
    },
    "test": {
      "dependsOn": ["^build", "^test", "generate", "^generate"],
      "env": ["TEST_DATABASE_URL", "REQUIRE_DB_TESTS"],
      "outputs": ["coverage/**", "sonar-report.xml"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "^test:coverage", "generate", "^generate"],
      "env": ["TEST_DATABASE_URL", "REQUIRE_DB_TESTS"],
      "outputs": ["coverage/**", "sonar-report.xml"]
    },
    "test:storybook": {
      "dependsOn": ["^build", "generate", "^generate"],
      "outputs": []
    },
    "test:storybook:dark": {
      "dependsOn": ["^build", "generate", "^generate"],
      "outputs": []
    },
    "build-storybook:test": {
      "dependsOn": ["^build", "generate", "^generate"],
      "outputs": []
    },
    "verify": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
