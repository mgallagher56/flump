{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "outputs": ["styled-system/**"],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types", "generate", "^generate"]
    },
    "test": {
      "dependsOn": ["^build", "^test", "generate", "^generate"],
      "outputs": ["coverage/**", "sonar-report.xml"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "^test:coverage", "generate", "^generate"],
      "outputs": ["coverage/**", "sonar-report.xml"]
    },
    "verify": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
